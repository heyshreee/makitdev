{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/contributors",
      "destination": "/contributors.html",
      "permanent": true
    },
    {
      "source": "/contributors/",
      "destination": "/contributors.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://makitdev.vercel.app/"
        }
      ]
    }
  ]
}
